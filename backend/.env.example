# ==============================================================================
# SHIELDLY AI Backend Server Environment Variables
# ==============================================================================

# Server Port (Render automatically sets this in production, default 5000)
PORT=5000
NODE_ENV=development

# Google Gemini API Key (Required for AI Reasoning & Screenshot Vision OCR)
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAI API Key (Secondary fallback provider)
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini

# Optional: Google Safe Browsing API Key (v4 threat matches)
GOOGLE_SAFE_BROWSING_API_KEY=""

# Optional: PostgreSQL Database URL
# If omitted or unavailable, backend operates in high-performance in-memory mode!
DATABASE_URL=""

# Allowed CORS Origins (comma-separated or '*' for all)
# e.g. https://your-project.vercel.app,http://localhost:3000
CORS_ORIGIN="*"
