# ==============================================================================
# SHIELDLY — Environment Variables Template
# Copy this file to `.env.local` (for local development) or configure these
# keys in your Vercel Project Settings -> Environment Variables.
# NEVER commit `.env` or `.env.local` to GitHub.
# ==============================================================================

# PostgreSQL connection string (used by Drizzle ORM for storing investigation reports)
# Local example: postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Cloud example (Neon / Supabase / Vercel Postgres): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ------------------------------------------------------------------------------
# AI Provider Configuration (Configure EITHER Google Gemini OR OpenAI)
# If both are set, Google Gemini is prioritized.
# All keys stay strictly server-side and are never exposed to the browser.
# ------------------------------------------------------------------------------

# Option 1: Google Gemini (Multimodal Vision + Text + URL analysis)
# Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Option 2: OpenAI (Multimodal Vision + Text + URL analysis)
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# Optional External URL Reputation Check
# Google Safe Browsing API v4 (only queried when configured)
# Obtain from https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
# ------------------------------------------------------------------------------
GOOGLE_SAFE_BROWSING_API_KEY=""
